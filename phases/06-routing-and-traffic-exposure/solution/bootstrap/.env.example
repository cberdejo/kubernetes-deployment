# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Optional PostgreSQL credentials.
# Leave POSTGRES_PASSWORD empty to let the Helm hook generate it once in-cluster.
# Set it only when you need a fixed URI-safe value; existing Secrets are not rotated.
POSTGRES_USER=admin
POSTGRES_DB=domain
POSTGRES_PASSWORD=

# Docker Hub — used to push/pull app images
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=1.0.0

# Chart source for todo-app.
# This phase defaults to the LOCAL canonical chart (application/chart), so it
# runs with no registry. The OCI path below is an optional PREVIEW of what
# becomes the real workflow in Phase 08 (Harbor) and Phase 09 (GitOps).
#
# To preview OCI: publish from solution/ with `./scripts/publish-chart.sh`
# (Docker Hub is a temporary bridge until Harbor exists), then set:
#   TODO_APP_CHART=oci://registry-1.docker.io/${DOCKERHUB_USER}/todo-app
# CHART_REGISTRY / CHART_VERSION are only used when TODO_APP_CHART is an oci:// URL.
TODO_APP_CHART=local
CHART_REGISTRY=
CHART_VERSION=0.1.0

# Helm release name for todo-app (default: my-app).
# Change this only if you deploy with a different release name.
RELEASE_NAME=my-app
