# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Optional PostgreSQL credentials.
# Leave POSTGRES_PASSWORD empty to let the canonical chart generate it once in-cluster.
POSTGRES_USER=admin
POSTGRES_DB=domain
POSTGRES_PASSWORD=

# Docker Hub — used to push/pull app images
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=1.0.0

# Chart source for todo-app.
# Phase 05 defaults to the LOCAL canonical chart (application/chart) so this
# phase is self-contained — no chart registry needed. Publishing/consuming the
# chart via OCI is introduced in Phase 06 (publish-chart.sh) and migrates to
# Harbor in Phase 08.
#
# To pull from an OCI registry instead, set TODO_APP_CHART explicitly:
#   TODO_APP_CHART=oci://registry-1.docker.io/${DOCKERHUB_USER}/todo-app
# CHART_REGISTRY / CHART_VERSION are only used when TODO_APP_CHART is an oci:// URL.
TODO_APP_CHART=local
CHART_REGISTRY=
CHART_VERSION=0.1.0

# Helm release name for todo-app (default: my-app).
# Change this only if you deploy with a different release name.
RELEASE_NAME=my-app
