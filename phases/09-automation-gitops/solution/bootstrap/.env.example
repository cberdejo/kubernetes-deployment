# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit it.
#
# In this phase .env is only read by the bootstrap and helper scripts.
# Flux never sees it: everything the cluster runs comes from Git.

# ── GitHub access for Flux ──────────────────────────────────────────
# Fine-grained personal access token restricted to this repository with
# "Contents: Read and write" (write is needed for image automation commits;
# additional exercise 9 in tasks.md splits it into a read-only and a write token).
# Using your own fork? Also change spec.sync.url in
# clusters/prod/flux-system/flux-instance.yaml.
# Your GitHub username (the owner of the fork Flux syncs)
GITHUB_USER=
GITHUB_TOKEN=

# ── Sealed Secrets key backup ───────────────────────────────────────
# Outside the repository! bootstrap.sh restores it (if present) before Flux
# installs the controller, and creates it (if missing) once the controller runs.
SEALED_SECRETS_KEY_BACKUP=$HOME/.homelab/sealed-secrets-key.yaml

# ── Initial images (seeded into Harbor by bootstrap.sh) ─────────────
# Build them first: docker build -t frontend:1.0.0 ../../../../application/frontend
IMAGE_TAG=1.0.0

# ── Credentials sealed by scripts/seal-platform-secrets.sh ──────────
# Allowed characters: A-Z a-z 0-9 . _ ~ -   (Flux injects them with Helm's
# --set parser, where commas and backslashes are special). Hex is ideal.

# authentik: secret key used to sign tokens and cookies. Generate once, never change.
#   openssl rand -hex 32
AUTHENTIK_SECRET_KEY=
# Initial admin (akadmin) password. Read only on first startup.
AUTHENTIK_BOOTSTRAP_PASSWORD=
# PostgreSQL password for authentik's database.
#   openssl rand -hex 16
AUTHENTIK_PG_PASSWORD=
# Optional admin email (only sealed when set).
AUTHENTIK_BOOTSTRAP_EMAIL=

# Harbor: admin password (8+ chars with upper case, lower case and a digit).
HARBOR_ADMIN_PASSWORD=
# Encryption key: must be exactly 16 characters.
#   openssl rand -hex 8
HARBOR_SECRET_KEY=
# Harbor project for the todo-app images and chart. Created by bootstrap.sh.
HARBOR_PROJECT=todo
