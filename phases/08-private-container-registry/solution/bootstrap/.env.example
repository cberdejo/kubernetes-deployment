# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Optional PostgreSQL credentials.
# Leave POSTGRES_PASSWORD empty to let the Helm hook generate it once in-cluster.
# Set it only when you need a fixed URI-safe value; existing Secrets are not rotated.
POSTGRES_USER=admin
POSTGRES_DB=domain
POSTGRES_PASSWORD=

# Container images — pushed to Harbor by scripts/push-images.sh
IMAGE_TAG=1.0.0

# Chart source for todo-app.
# Phase 08 defaults to the LOCAL canonical chart (application/chart).
# After running scripts/publish-chart.sh, set:
#   TODO_APP_CHART=oci://harbor.local/todo/todo-app
# to install from the Harbor OCI registry.
TODO_APP_CHART=local
CHART_VERSION=0.1.0

# Helm release name for todo-app (default: my-app).
RELEASE_NAME=my-app

# ── Authentik ───────────────────────────────────────────────────────
# Secret key used to sign tokens and cookies. Generate once, never change.
#   openssl rand -base64 36
AUTHENTIK_SECRET_KEY=
# Initial admin (akadmin) password. Read only on first startup.
AUTHENTIK_BOOTSTRAP_PASSWORD=
# PostgreSQL password for authentik's database.
AUTHENTIK_PG_PASSWORD=
# Optional admin email.
AUTHENTIK_BOOTSTRAP_EMAIL=

# ── Harbor ──────────────────────────────────────────────────────────
# Admin password for Harbor UI and API.
HARBOR_ADMIN_PASSWORD=
# Encryption key — must be exactly 16 characters.
#   openssl rand -hex 8
HARBOR_SECRET_KEY=
# Harbor project name (default: todo). Created automatically by bootstrap.
HARBOR_PROJECT=todo
